# As correlate-assign-full, plus a clock offset per pair of sources, fitted
# with the position offset (spec/correlate-assign.md, Sensor bias, Time
# offset): an offset along the track that grows with speed is read as a clock
# error, not a position bias. Prior 500 ms.
# Stale after 5 times the source's median update interval (last 9), within
# 5 s and 60 s: five missed updates in a row at a detection probability of
# 0.5 happen about 3 % of the time.
pack        correlate-assign-time
version     1.0.0
method      assign
filter      accel_var=1 default_ce_m=50 vel_sigma_ms=5 unknown_vel_ms=100
maneuver    accel_var=400 p_enter=0.05 p_leave=0.1
restart     gate=200
gate        mahalanobis gate=18.42
gate        same key=track.simulated
gate        same key=@env
new_cost    9.21
keep_bonus  2
stale_rate  factor=5 floor_ms=5000 ceiling_ms=60000 samples=9
bias        sigma_m=300 floor_m=10 gate=13.82
window      2
hypotheses  3
margin      0.5
time_offset sigma_ms=500
