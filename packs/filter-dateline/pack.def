# An area across the antimeridian. Reports inside the zone, from 175 E to
# 175 W and 10 S to 10 N, are kept, as are reports within 10 km of an
# anchorage on the antimeridian. Elsewhere, a report is kept when it carries a
# mission tag alpha or bravo with priority 1 to 3, or comes from a listed
# test track of the range source.
pack       filter-dateline
version    0.1.0
default    drop
forget_ms  600000

rule  zone       keep
when  polygon vertices=-10,175;-10,-175;10,-175;10,175

rule  anchorage  keep
when  circle lat=20 lon=180 radius_m=10000

rule  tasked     keep
when  key name=mission in=alpha,bravo
when  key name=priority min=1 max=3

rule  range-test keep
when  source in=range
when  uid in=TGT1,TGT2
