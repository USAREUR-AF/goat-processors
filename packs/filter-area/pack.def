# An operating box with own-ship distance. Own ship is always kept. A report
# outside the box, or inside a harbor circle, is dropped. Inside the box, a
# report within 40 km of own ship (predicted to the report's time, own ship no
# older than 60 s) is kept, and so is an air report at 6000 m or above.
# Everything else is dropped.
pack       filter-area
version    0.1.0
default    drop
forget_ms  600000

rule  own-ship       keep
when  source in=own

rule  outside-box    drop
when  not polygon vertices=0.5,0.5;0.5,1.5;1.5,1.5;1.5,0.5

rule  harbor        drop
when  circle lat=1.3 lon=1.3 radius_m=5000

rule  near-own-ship  keep
when  near reference=own/OS1 radius_m=40000 max_age_ms=60000

rule  high-air       keep
when  env in=A
when  altitude min=6000
