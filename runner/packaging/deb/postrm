#!/bin/sh
set -e
if [ -d /run/systemd/system ]; then
  systemctl daemon-reload >/dev/null 2>&1 || true
fi
if [ "$1" = purge ]; then
  rm -rf /var/lib/goat-processors
  # /etc/goat-processors/tls holds certificates the site placed; it is kept.
  getent passwd goat-processors >/dev/null && deluser --system goat-processors >/dev/null 2>&1 || true
fi
exit 0
