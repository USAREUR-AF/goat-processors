# Test-only fixture (not a shipped pack, not in the spec): correlate-assign
# with the test kind "noop", which noop_test.go registers, as the first gate.
pack        noop-assign
version     0.1.0
method      assign
filter      accel_var=1 default_ce_m=50 vel_sigma_ms=5 unknown_vel_ms=100
gate        noop
gate        mahalanobis gate=18.42
gate        same key=track.simulated
gate        same key=@env
new_cost    9.21
keep_bonus  2
stale_ms    120000
