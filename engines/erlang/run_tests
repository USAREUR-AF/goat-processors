#!/bin/sh
# Build, then run the correlate vectors (packs/correlate-*, spec/correlate-load-vectors),
# the filter vectors (packs/filter-*, spec/filter-load-vectors), the fuse vectors
# (packs/fuse-*, spec/fuse-load-vectors) and the quality vectors (packs/quality-*,
# spec/quality-load-vectors); then the unit, property and fuzz tests (test/,
# EUnit). Non-zero when any vector or test fails.
set -e
here="$(cd "$(dirname "$0")" && pwd)"
root="$here/../.."
"$here/build.sh"
"$here/test/build_tests.sh"
status=0
echo "== correlate"
erl -noshell -pa "$here/ebin" -run correlator_vectors main "$root" || status=1
echo "== filter"
erl -noshell -pa "$here/ebin" -run filter_vectors main "$root" || status=1
echo "== fuse"
erl -noshell -pa "$here/ebin" -run fuse_vectors main "$root" || status=1
echo "== quality"
erl -noshell -pa "$here/ebin" -run quality_vectors main "$root" || status=1
echo "== tests"
GOAT_ROOT="$root" erl -noshell -pa "$here/ebin" -pa "$here/test/ebin" -run test_support main || status=1
exit $status
