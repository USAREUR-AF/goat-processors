# A test-only fixture (engines/erlang/test/registration_tests.erl), not a
# pack of packs/ and not in the spec: correlate-gnn with one more gate test,
# `noop`, a test kind the test registers for this load only.
pack           correlate-noop
version        0.1.0
filter         accel_var=1 default_ce_m=50 vel_sigma_ms=5 unknown_vel_ms=100
gate           noop
gate           mahalanobis gate=9.21
gate           same key=track.simulated
gate           same key=@env
confirm        course max_deg=45 min_speed_ms=5
confirm        speed max_pct=40 min_speed_ms=5
confirm        altitude max_m=300
confirm_count  2
hold           mahalanobis gate=18.42
hold_failures  2
stale_ms       120000
same_source    forbid
output         priority
