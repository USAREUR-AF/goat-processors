# Test fixture of the Python engine only (not a shipped pack, not in the
# spec): packs/correlate-assign with the no-op test `noop` first in the gate.
# `noop` is registered only by tests/test_registration.py; the engine's own
# table does not know it, so this pack does not load through FUNCTIONS.
pack        correlate-noop
version     0.1.0
method      assign
filter      accel_var=1 default_ce_m=50 vel_sigma_ms=5 unknown_vel_ms=100
gate        noop
gate        mahalanobis gate=18.42
gate        same key=track.simulated
gate        same key=@env
new_cost    9.21
keep_bonus  2
stale_ms    120000
