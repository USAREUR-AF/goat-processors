# Test-only fixture (tests/registry.rs): packs/correlate-gnn with the no-op
# test kind on the gate and confirm stages. Only a registry that registers
# `noop` loads it; the spec's registry refuses it (unknown test).
pack           correlate-noop
version        0.1.0
filter         accel_var=1 default_ce_m=50 vel_sigma_ms=5 unknown_vel_ms=100
gate           mahalanobis gate=9.21
gate           same key=track.simulated
gate           same key=@env
gate           noop
confirm        course max_deg=45 min_speed_ms=5
confirm        speed max_pct=40 min_speed_ms=5
confirm        altitude max_m=300
confirm        noop
confirm_count  2
hold           mahalanobis gate=18.42
hold_failures  2
stale_ms       120000
same_source    forbid
output         priority
